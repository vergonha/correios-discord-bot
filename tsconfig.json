{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",

    "moduleResolution": "Bundler",

    "outDir": "dist",
    "rootDir": "src",

    "strict": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["bun-types"]
  },
  "exclude": ["tests", "dist", "node_modules"]
}
